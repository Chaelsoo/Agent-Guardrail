{
  "id": "aegis-guard",
  "name": "Aegis Guard",
  "description": "Guardrail sidecar — inspects user prompts, LLM responses, and tool calls via a local Aegis server.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "aegisUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8000/v1",
        "description": "Base URL of the Aegis guardrail server."
      },
      "environment": {
        "type": "string",
        "default": "dev"
      },
      "agentType": {
        "type": "string",
        "default": "general"
      },
      "enforceInputGate": {
        "type": "boolean",
        "default": true
      },
      "enforceOutputGate": {
        "type": "boolean",
        "default": true
      },
      "enforceToolGate": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
