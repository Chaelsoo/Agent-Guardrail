# Core settings
AEGIS_THRESHOLD=0.5
OUTPUT_BLOCK_THRESHOLD=0.75
OUTPUT_FLAG_THRESHOLD=0.5

# LLM Judge Configuration
# Get a DeepSeek API key from: https://platform.deepseek.com/
# Or use OpenAI, Groq, or OpenRouter
LLM_JUDGE_API_KEY=your_api_key_here
LLM_JUDGE_MODEL=deepseek-chat
LLM_JUDGE_PROVIDER=deepseek

# Job B periodic audit (every N turns)
JUDGE_AUDIT_INTERVAL=3

# Taint resolution (consecutive ALIGNED verdicts to clear taint)
TAINT_RESOLUTION_THRESHOLD=2

# Database
DATABASE_URL=sqlite:///aegis.db
AEGIS_DB_ENABLED=true

# HuggingFace (required for gated models)
HF_TOKEN=
